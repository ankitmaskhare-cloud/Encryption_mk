# ---------------------------------------------------------------------------
# MR-KING PHANTOM — Environment Variables template
# Copy to `.env` for local testing. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# "production" or "development". In production:
#   - CORS '*' is refused at startup.
#   - /docs and /openapi.json are disabled.
ENV=production

# ---- Master key (KEK) -----------------------------------------------------
# 32-byte AES-256 key, base64-encoded.
# Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Store the OUTPUT ONLY in a password manager AND in this env var.
MRK_MASTER_KEY_B64=

# Current key version (>=1). New payloads get stamped with this.
# Bump when you rotate the master key.
MRK_MASTER_KEY_VERSION=1

# Older keys for backward-compatible decryption (key rotation).
# Add _V1, _V2, ... as needed. Example:
# MRK_MASTER_KEY_B64_V1=

# ---- Firebase -------------------------------------------------------------
# Full service account JSON on ONE line.
# Get it from Firebase Console → Project settings → Service accounts
#   → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID (must match service account).
FIREBASE_PROJECT_ID=encryption-ee299

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins. NO trailing slash.
# In production, '*' is REJECTED at startup.
# Example:
#   ALLOWED_ORIGINS=https://mrkingphantom.example.com,https://app.example.com
ALLOWED_ORIGINS=

# ---- Rate limiting (per Firebase UID, sliding window) ---------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENCRYPT=30
RATE_LIMIT_DECRYPT=60